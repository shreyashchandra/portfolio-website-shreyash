# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.

# Admin login (/admin). Use a long, unique password (12+ characters).
ADMIN_PASSWORD=
# Random secret for signing the session cookie (32+ characters). Generate with:  openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Where admin edits are committed (production). Without these, local dev writes straight to the files.
# Fine-grained GitHub token: only this repo, permission "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=shreyashchandra/portfolio-website-shreyash
GITHUB_BRANCH=main
